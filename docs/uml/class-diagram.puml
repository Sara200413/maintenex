@startuml
skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false

enum TypeIntervention {
  PREVENTIVE
  CORRECTIVE
}

enum StatutEquipement {
  EN_SERVICE
  EN_PANNE
  EN_MAINTENANCE
}

enum StatutIntervention {
  PLANIFIEE
  EN_COURS
  TERMINEE
}


class Equipement {
  +id : Long
  +code : String
  +nom : String
  +type : String
  +localisation : String
  +dateMiseEnService : LocalDate
  +statut : StatutEquipement
  +/nbPannes : int
}

class Technicien {
  +id : Long
  +nom : String
  +specialite : String
  +email : String
}

class Intervention {
  +id : Long
  +type : TypeIntervention
  +datePlanifiee : LocalDate
  +dateRealisation : LocalDate
  +dureeMin : int
  +cout : double
  +statut : StatutIntervention
  +description : String
  +terminer(date : LocalDate, duree : int, cout : double) : void
}

Equipement "1" <-- "0..*" Intervention : est sujet de >
Technicien "1" <-- "0..*" Intervention : réalise <


note right of Equipement::"/nbPannes"
  Attribut dérivé (RG-07) :
  Comptage des interventions
  de type CORRECTIVE
end note

note right of Intervention::"terminer"
  Précondition (RG-08) :
  statut <> TERMINEE
end note

@enduml
